spring.application.name=fincontrol-backend

# Database Config
spring.datasource.url=jdbc:mysql://localhost:3306/fincontrol?createDatabaseIfNotExist=true&serverTimezone=UTC
spring.datasource.username=root
spring.datasource.password=YOUR_PASSWORD_HERE
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# JPA Config
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
logging.level.org.hibernate=ERROR
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect

# Multi-Tenancy Config
spring.jpa.properties.hibernate.tenant_identifier_resolver=com.fincontrol.infrastructure.tenant.TenantResolver

# JWT Config (Custom)
fincontrol.jwt.secret=YOUR_JWT_SECRET_HERE
fincontrol.jwt.expiration=86400000
